<service name="documentlibrary" package="com.github.hwc2243.documentlibrary">
    <entity name="documentLibrary">
        <attribute name="name" type="string" />
        
        <finder unique="true">
            <finder-attribute name="name" />
        </finder>
    </entity>

    <entity name="documentObject" abstract="true">
        <attribute name="name" type="string" />
        <attribute name="objectType" type="enum" enum-values="FILE,FOLDER" />
        
        <related name="library" 
                 entity="documentLibrary" 
                 relationship="many_to_one" />
                 
        <related name="parentFolder" 
                 entity="documentFolder" 
                 relationship="many_to_one" />
                 
        <finder unique="true">
        	<finder-attribute name="name"/>
        	<finder-attribute name="library"/>
        	<finder-attribute name="parentFolder"/>
        </finder>
        
    	<finder>
    		<finder-attribute name="library" />
    		<finder-attribute name="parentFolder" />
    	</finder>
    </entity>

    <entity name="documentFolder" parent="documentObject">
    </entity>

    <entity name="documentFile" parent="documentObject">
        <attribute name="size" type="long" />
        <attribute name="mimeType" type="string" />
    </entity>

    <entity name="documentFileVersion">
        <attribute name="version" type="long" />
        <attribute name="size" type="long" />
        <attribute name="mimeType" type="string" />
        <attribute name="createDate" type="datetime" />
        
        <related name="documentFile" 
                 entity="documentFile" 
                 relationship="many_to_one"/>
                 
        <finder>
        	<finder-attribute name="documentFile" />
        </finder>
    </entity>
</service>
